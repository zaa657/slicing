{
  "name": "todo-api",
  "version": "1.0.0",
  "description": "API belajar login JWT + Todo List (Express + MySQL) untuk slicing design Flutter",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/database/migrate.js up",
    "migrate:rollback": "node src/database/migrate.js down",
    "migrate:fresh": "node src/database/migrate.js fresh",
    "seed": "node src/database/seed.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "swagger-ui-express": "^5.0.1"
  }
}
